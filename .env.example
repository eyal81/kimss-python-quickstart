# Step 1 - Get your free API key at https://kimss.ai/app/signup
# (25,000 governed requests/mo included. No credit card.)
KIMSS_API_KEY=kimss_xxxxxxxxxxxxxxxxxxxxxxxx

# Step 2 - Copy your agent id from the Gateway tab after vaulting a provider key
KIMSS_AGENT_ID=asst_xxxxxxxx

# Logical model id from your workspace (example_02_openai_override.py)
KIMSS_MODEL=gpt-5.6-sol

# Optional override (default: https://api.kimss.ai)
KIMSS_BASE_URL=https://api.kimss.ai
